---
interface Props {
  note: {
    id: string;
    data: {
      title: string;
      summary: string;
      date: Date;
      image?: string;
      featured: boolean;
    };
    body?: string;
  };
}
const { note }: Props = Astro.props;
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
const readTime = Math.max(1, Math.round((note.body?.trim().split(/\s+/).filter(Boolean).length ?? 0) / 200));
---
<a class="note-card" href={`/notes/${note.id}`}>
  <div class="note-thumb">
    <img src="/assets/dither-fade.png" alt="" />
  </div>
  <div class="note-copy">
    <h2>{note.data.title}</h2>
    <p class="note-excerpt">{note.data.summary}</p>
    <div class="post-meta">{formatDate(note.data.date)} · {readTime} min read</div>
    <span class="note-arrow" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  .note-card:hover { border-color: #8f8f8f; box-shadow: 0 8px 22px rgba(0,0,0,.12); }
  .note-card { position: relative; width: 560px; min-height: 220px; display: grid; grid-template-columns: 34% 66%; overflow: hidden; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.8) inset, 0 7px 18px rgba(0,0,0,.08); }
  :global(html[data-theme="dark"]) .note-card:hover { border-color: #363636; box-shadow: 0 8px 22px rgba(0,0,0,.35); }
  :global(html[data-theme="dark"]) .note-card { box-shadow: 0 1px 0 rgba(255,255,255,.05) inset, 0 7px 18px rgba(0,0,0,.3); }
  .note-thumb { position: relative; z-index: 1; grid-column: 1; min-width: 0; height: 100%; overflow: hidden; background: var(--panel); }
  .note-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; image-rendering: pixelated; filter: grayscale(1) contrast(1.05); -webkit-mask-image: linear-gradient(to right, #000 0%, #000 52%, transparent 100%); mask-image: linear-gradient(to right, #000 0%, #000 52%, transparent 100%); transition: transform .5s ease; }
  :global(html[data-theme="dark"]) .note-thumb img { filter: invert(1) contrast(1.08); }
  .note-card:hover .note-thumb img { transform: scale(1.02); }
  .note-copy { position: relative; z-index: 2; grid-column: 2; min-width: 0; min-height: 0; padding: 26px 28px 16px 22px; display: flex; flex-direction: column; justify-content: flex-start; gap: 8px; background: var(--panel); }
  .note-copy h2 { margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-family: var(--serif); font-size: 21px; line-height: 1.24; letter-spacing: -.015em; font-weight: 560; }
  .note-excerpt { margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: var(--muted); font-family: var(--serif); font-size: 14px; line-height: 1.55; }
  .note-copy .post-meta { margin-top: auto; padding-top: 6px; }
  .note-arrow { position: absolute; right: 13px; bottom: 13px; color: var(--ink); font-size: 16px; }
  @media (max-width: 680px) {
    .note-card { width: min(560px, 100%); }
  }
  @media (max-width: 480px) {
    .note-card { grid-template-columns: 1fr; min-height: 0; }
    .note-thumb { grid-column: 1; grid-row: 1; height: 160px; }
    .note-copy { grid-column: 1; grid-row: 2; padding: 20px 20px 44px; }
    .note-copy h2 { font-size: 19px; -webkit-line-clamp: 3; }
    .note-excerpt { font-size: 14px; -webkit-line-clamp: 3; }
  }
</style>
