<div class="interaction-field" aria-hidden="true"><canvas id="interaction-cursor"></canvas></div>

<style is:global>
  @media (pointer: fine) {
    body.portfolio-surface,
    body.portfolio-surface a,
    body.portfolio-surface button { cursor: none; }
  }

  #interaction-cursor {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }

  .tactile-shell {
    position: relative;
    transform-style: preserve-3d;
    perspective: 1400px;
    isolation: isolate;
  }

  .tactile-shell::before,
  .tactile-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border: 1px solid rgba(35,36,35,.38);
    background: #dfe0dd;
    z-index: -2;
    transform: translate3d(4px, 5px, -8px);
  }

  .tactile-shell::after {
    transform: translate3d(2px, 3px, -4px);
    background: #eef0ec;
    z-index: -1;
  }

  .tactile-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .tactile-front,
  .tactile-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .tactile-back {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    background:
      radial-gradient(circle at 20% 20%, rgba(255,255,255,.84), transparent 30%),
      radial-gradient(circle, rgba(35,36,35,.11) 1px, transparent 1px),
      linear-gradient(145deg, #f8f9f6, #e4e6e1);
    background-size: auto, 6px 6px, auto;
    border: 1px solid #232423;
    transform: rotateY(180deg) translateZ(1px);
    color: #232423;
    font-family: 'IBM Plex Mono', monospace;
  }

  .tactile-back__eyebrow {
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .58;
  }

  .tactile-back__name {
    margin: 0;
    max-width: 13ch;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(24px, 4vw, 42px);
    line-height: .96;
    letter-spacing: -.04em;
  }

  .tactile-back__body {
    max-width: 32ch;
    font-size: 11px;
    line-height: 1.6;
    opacity: .72;
  }

  .tactile-back__hint {
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .44;
  }

  .tactile-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    z-index: 20;
    mix-blend-mode: screen;
  }

  .project-card.tactile-shell,
  .world-card.tactile-shell,
  .note-row.tactile-shell {
    overflow: visible;
  }

  .project-card.tactile-shell > .tactile-inner,
  .world-card.tactile-shell > .tactile-inner,
  .note-row.tactile-shell > .tactile-inner {
    background: inherit;
  }

  .dither-swap {
    position: relative;
    overflow: hidden;
  }

  .dither-swap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(circle, rgba(255,255,255,.85) 1px, transparent 1.2px),
      linear-gradient(135deg, rgba(30,31,30,.25), transparent 58%);
    background-size: 5px 5px, auto;
    mix-blend-mode: difference;
    transition: opacity .35s ease;
  }

  .dither-swap:hover::after { opacity: .74; }

  body.portfolio-inverted {
    filter: invert(1);
    background: #0c0d0c;
  }

  body.portfolio-inverted img,
  body.portfolio-inverted video { filter: invert(1); }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    #interaction-cursor { display: none; }
    .tactile-shell::before,
    .tactile-shell::after { display: none; }
    .tactile-inner { transform: none !important; }
    .tactile-back { display: none; }
  }
</style>

<script is:inline>
(function () {
  'use strict';

  document.body.classList.add('portfolio-surface');

  var fine = window.matchMedia && window.matchMedia('(pointer:fine)').matches;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var identities = {
    millie: ['operating familiar', 'a small nocturnal intelligence that swims between tools without losing itself.'],
    wakomi: ['resident guide', 'a calm little navigator for paperwork, language and the administrative weather of life in Japan.'],
    huhu: ['quiet shadow', 'a local companion whose most important ability is knowing when there is not enough evidence to speak.'],
    motes: ['field creature', 'a living cluster made from notes, links and small deterministic relationships rather than a chat transcript.'],
    loket: ['document courier', 'a precise little worker that gets the right papers from one human to another without making the process heavier.'],
    lexine: ['archive familiar', 'a careful reader that searches the room, cites what it found and refuses to invent the missing page.']
  };

  function slugFor(el) {
    var href = el.getAttribute('href') || '';
    var match = href.match(/\/work\/([^/?#]+)/);
    if (match) return match[1].toLowerCase();
    var text = (el.querySelector('h2,h3,strong') || el).textContent || '';
    return text.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  function enhance(el, allowFlip) {
    if (!fine || reduced || el.dataset.tactileReady) return;
    el.dataset.tactileReady = 'true';
    el.classList.add('tactile-shell');

    var children = Array.prototype.slice.call(el.childNodes);
    var inner = document.createElement('div');
    inner.className = 'tactile-inner';
    var front = document.createElement('div');
    front.className = 'tactile-front';
    children.forEach(function (node) { front.appendChild(node); });
    inner.appendChild(front);

    var slug = slugFor(el);
    var identity = identities[slug];
    if (allowFlip && identity) {
      var back = document.createElement('div');
      back.className = 'tactile-back';
      back.innerHTML = '<div class="tactile-back__eyebrow">other self / ' + slug + '</div>' +
        '<div><h3 class="tactile-back__name">' + identity[0] + '</h3><p class="tactile-back__body">' + identity[1] + '</p></div>' +
        '<div class="tactile-back__hint">visual world in development · drag to return</div>';
      inner.appendChild(back);
    }

    var glare = document.createElement('div');
    glare.className = 'tactile-glare';
    inner.appendChild(glare);
    el.appendChild(inner);

    var tx = 0, ty = 0, cx = 0, cy = 0, vx = 0, vy = 0;
    var rot = 0, rotTarget = 0, rv = 0;
    var dragging = false, armed = false, dragX = 0, rotStart = 0, moved = 0, raf = null;

    function loop() {
      vx = vx * .88 + (tx - cx) * .012;
      vy = vy * .88 + (ty - cy) * .012;
      cx += vx; cy += vy;
      if (!dragging) { rv = rv * .9 + (rotTarget - rot) * .016; rot += rv; }
      inner.style.transform = 'rotateX(' + cy.toFixed(2) + 'deg) rotateY(' + (rot + cx).toFixed(2) + 'deg)';
      var fx = (cx / 14 + .5) * 100;
      var fy = (.5 - cy / 12) * 100;
      var amt = Math.min(1, Math.abs(cx) / 14 + Math.abs(cy) / 12);
      glare.style.opacity = (amt * .52).toFixed(2);
      glare.style.background = 'radial-gradient(460px circle at ' + fx + '% ' + fy + '%, rgba(255,255,255,.6), rgba(255,255,255,.12) 40%, transparent 70%)';
      if (dragging || Math.abs(cx-tx)>.02 || Math.abs(cy-ty)>.02 || Math.abs(rot-rotTarget)>.05 || Math.abs(vx)>.02 || Math.abs(vy)>.02 || Math.abs(rv)>.02) raf=requestAnimationFrame(loop); else raf=null;
    }
    function kick(){ if(!raf) raf=requestAnimationFrame(loop); }

    el.addEventListener('mousemove', function(e){
      var r=el.getBoundingClientRect();
      tx=((e.clientX-r.left)/r.width-.5)*14;
      ty=-((e.clientY-r.top)/r.height-.5)*12;
      kick();
    });
    el.addEventListener('mouseleave', function(){ tx=0; ty=0; kick(); });

    if (allowFlip && identity) {
      el.addEventListener('pointerdown', function(e){ armed=true; dragging=false; moved=0; dragX=e.clientX; rotStart=rot; });
      el.addEventListener('pointermove', function(e){
        if(!armed) return;
        var dx=e.clientX-dragX; moved=Math.max(moved,Math.abs(dx));
        if(!dragging && moved>7){ dragging=true; el.style.userSelect='none'; }
        if(!dragging) return;
        rot=rotStart+dx*.48; kick();
      });
      function end(){
        armed=false;
        if(!dragging) return;
        dragging=false; el.style.userSelect='';
        rotTarget=Math.round(rot/180)*180; rv=0; kick();
      }
      el.addEventListener('pointerup',end); el.addEventListener('pointercancel',end);
      el.addEventListener('click',function(e){ if(moved>7){e.preventDefault();e.stopPropagation();}},true);
    }
  }

  document.querySelectorAll('.project-card').forEach(function(el){ enhance(el,true); });
  document.querySelectorAll('.world-card').forEach(function(el){ enhance(el,true); });
  document.querySelectorAll('.note-row').forEach(function(el){ enhance(el,false); });
  document.querySelectorAll('.hero-image, .world-image').forEach(function(el){ el.classList.add('dither-swap'); });

  if (!fine || reduced) return;

  var cv=document.getElementById('interaction-cursor');
  if(!cv) return;
  var ctx=cv.getContext('2d');
  function resize(){ cv.width=window.innerWidth*devicePixelRatio; cv.height=window.innerHeight*devicePixelRatio; cv.style.width=window.innerWidth+'px'; cv.style.height=window.innerHeight+'px'; ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0); }
  resize(); window.addEventListener('resize',resize);
  var parts=[], mouse={x:-100,y:-100};
  window.addEventListener('mousemove',function(e){ mouse={x:e.clientX,y:e.clientY}; parts.push({x:e.clientX+(Math.random()*10-5),y:e.clientY+(Math.random()*10-5),life:1}); if(parts.length>240)parts.splice(0,parts.length-240); });
  var arrow=new Path2D('M2 1 C2 .2 2.8 -.2 3.4 .3 L14.5 10.2 C15.2 10.8 14.8 12 13.9 12 L9.6 12.1 L11.9 17.2 C12.2 17.9 11.9 18.7 11.2 19 L9.9 19.5 C9.2 19.8 8.4 19.5 8.1 18.8 L5.9 13.7 L3.1 16.7 C2.5 17.4 1.3 17 1.3 16 Z');
  function draw(){
    ctx.clearRect(0,0,window.innerWidth,window.innerHeight); var g=6;
    for(var i=0;i<parts.length;i++){ var p=parts[i]; p.life-=.028; if(p.life<=0)continue; ctx.globalAlpha=p.life*.72; ctx.fillStyle='#3A3B39'; ctx.fillRect(Math.round(p.x/g)*g,Math.round(p.y/g)*g,g,g); }
    parts=parts.filter(function(p){return p.life>0;}); ctx.globalAlpha=1; ctx.save(); ctx.translate(mouse.x,mouse.y); ctx.scale(1.15,1.15); ctx.fillStyle='#FBFCFA'; ctx.fill(arrow); ctx.lineWidth=1.6; ctx.strokeStyle='#232423'; ctx.lineJoin='round'; ctx.stroke(arrow); ctx.restore(); requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();
</script>
