---
import { getCollection } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';
const notes = (await getCollection('notes')).filter((n) => !n.data.draft).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<JournalLayout active="archive" title="Archive — Thomas" description="Research notes, build logs, experiments and essays by Thomas.">
  <header class="archive-intro">
    <div class="eyebrow">ARCHIVE</div>
    <h1>Everything I decided was worth writing down.</h1>
    <p>Technical notes, research, experiments, failures, useful hacks and longer explanations. Newest first.</p>
  </header>

  <div class="section-heading"><span>Notebook</span><span>{String(notes.length).padStart(2,'0')} entries</span></div>
  <div class="archive-list">
    {notes.map((note) => (
      <a class="archive-row" href={`/notes/${note.id}`}>
        <div class="post-meta">{formatDate(note.data.date)} · {note.data.kind}</div>
        <div>
          <h2>{note.data.title}</h2>
          <p>{note.data.summary}</p>
        </div>
        <span class="read">↗</span>
      </a>
    ))}
  </div>
</JournalLayout>

<style>
  .archive-intro { max-width: 820px; padding: 8px 0 54px; }
  .archive-intro h1 { margin: 15px 0 17px; font-size: clamp(42px,5.5vw,74px); line-height: .99; letter-spacing: -.052em; font-weight: 500; }
  .archive-intro p { max-width: 670px; margin: 0; color: var(--muted); font: 13px/1.65 var(--mono); }
  .archive-list { border-top: 1px solid var(--line); }
  .archive-row { display: grid; grid-template-columns: 150px minmax(0,1fr) auto; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); text-decoration: none; align-items: start; }
  .archive-row h2 { margin: 0 0 8px; font-size: clamp(23px,2.6vw,34px); line-height: 1.05; letter-spacing: -.038em; font-weight: 500; }
  .archive-row p { max-width: 720px; margin: 0; color: #6d6d66; font: 12px/1.6 var(--mono); }
  .archive-row:hover h2, .archive-row:hover .read { color: var(--signal); }
  @media (max-width: 680px) { .archive-row { grid-template-columns: 1fr auto; gap: 8px 16px; } .archive-row .post-meta { grid-column: 1 / -1; } }
</style>
