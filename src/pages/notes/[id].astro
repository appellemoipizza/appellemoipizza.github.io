---
import { getCollection, render } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => !note.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const author = note.data.author ?? 'ピザって呼んで';
---
<JournalLayout title={note.data.title} description={note.data.summary}>
  <article class="note">
    <a class="back" href="/home">← Journal</a>

    <header class="meta-card">
      {note.data.image && (
        <div class="meta-photo">
          <img src={note.data.image} alt="" />
        </div>
      )}
      <div class="meta-body">
        <div class="kicker">{note.data.kind}{note.data.project && <> · {note.data.project}</>}</div>
        <h1>{note.data.title}</h1>
        <p class="summary">{note.data.summary}</p>

        <dl class="meta-grid">
          <div><dt>Written by</dt><dd>{author}</dd></div>
          <div><dt>Published</dt><dd>{date}</dd></div>
          {note.data.project && <div><dt>Project</dt><dd>{note.data.project}</dd></div>}
        </dl>

        {note.data.tags.length > 0 && (
          <div class="tags" aria-label="Article tags">
            {note.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    <div class="body-card">
      <div class="prose"><Content /></div>
    </div>
  </article>
</JournalLayout>

<style>
  .note { max-width: 800px; margin: 0 auto; padding: 20px 18px 80px; }
  .back { display: inline-block; margin: 4px 0 22px; color: var(--muted); font: 9px/1 var(--mono); text-decoration: none; text-transform: uppercase; letter-spacing: .06em; }

  /* ---- top card: photo + metadata ---- */
  .meta-card { border: 1px solid var(--ink); border-radius: 10px; overflow: hidden; background: var(--panel); box-shadow: 0 1px 0 rgba(255,255,255,.95) inset, 0 10px 26px rgba(35,36,35,.045); }
  .meta-photo { border-bottom: 1px solid var(--line); background: #dcdbd4; }
  .meta-photo img { display: block; width: 100%; max-height: 380px; object-fit: cover; image-rendering: pixelated; filter: grayscale(1) contrast(1.05); }
  .meta-body { padding: clamp(24px, 4vw, 44px); }
  .kicker { color: var(--muted); font: 9px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 16px; font-size: clamp(32px, 4.4vw, 54px); line-height: 1; letter-spacing: -.04em; font-weight: 560; }
  .summary { margin: 0; max-width: 620px; color: #5b5d57; font-size: 15px; line-height: 1.6; }
  .meta-grid { margin: 28px 0 0; padding-top: 22px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 30px; }
  .meta-grid > div { display: grid; gap: 5px; }
  .meta-grid dt { margin: 0; color: var(--muted); font: 8px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; }
  .meta-grid dd { margin: 0; font-size: 12px; line-height: 1.2; font-weight: 560; }
  .tags { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 7px; }
  .tags span { padding: 6px 8px; border: 1px solid var(--line); border-radius: 999px; color: #62645e; background: rgba(255,255,255,.6); font: 8px/1 var(--mono); }

  /* ---- bottom card: article body ---- */
  .body-card { margin-top: 18px; border: 1px solid var(--ink); border-radius: 10px; background: var(--panel); padding: clamp(24px, 5vw, 56px); box-shadow: 0 1px 0 rgba(255,255,255,.95) inset, 0 10px 26px rgba(35,36,35,.045); }
  .prose { font-size: 16px; line-height: 1.75; letter-spacing: -.006em; }
  .prose :global(p) { margin: 0 0 1.3em; }
  .prose :global(h2) { margin: 2.4em 0 .7em; font-size: 25px; line-height: 1.14; letter-spacing: -.025em; font-weight: 560; }
  .prose :global(h3) { margin: 2em 0 .65em; font-size: 18px; line-height: 1.2; }
  .prose :global(strong) { font-weight: 620; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.15em; }
  .prose :global(li) { margin: 0 0 .5em; }
  .prose :global(code) { padding: .12em .32em; background: var(--soft); border: 1px solid var(--line); font-family: var(--mono); font-size: .82em; }

  /* code / schema / data blocks read as their own greyscale cards */
  .prose :global(pre) { position: relative; margin: 1.9em 0; overflow-x: auto; padding: 22px 20px 18px; border: 1px solid var(--ink); border-radius: 8px; background: #f0efe9; font: 12.5px/1.65 var(--mono); filter: grayscale(1) contrast(1.02); }
  .prose :global(pre code) { padding: 0; border: 0; background: none; }
  .prose :global(pre[data-language])::before {
    content: attr(data-language);
    position: absolute; top: 0; right: 0;
    padding: 4px 9px;
    border: 1px solid var(--ink); border-top: 0; border-right: 0;
    border-radius: 0 8px 0 8px;
    background: var(--ink); color: var(--paper);
    font: 8px/1 var(--mono); text-transform: uppercase; letter-spacing: .07em;
  }

  .prose :global(blockquote) { margin: 1.8em 0; padding: 3px 0 3px 20px; border-left: 2px solid #aaa9a2; color: #555750; font-size: 17px; line-height: 1.5; }
  .prose :global(a) { text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .note { padding: 12px 10px 64px; }
    h1 { font-size: clamp(30px, 9vw, 42px); }
    .meta-grid { gap: 18px; }
  }
</style>
