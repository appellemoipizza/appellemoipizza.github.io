---
import { getCollection, render } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => !note.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---
<JournalLayout active="archive" title={`${note.data.title} — Thomas`} description={note.data.summary}>
  <article class="note">
    <a class="back" href="/notes">← archive</a>
    <header>
      <div class="post-meta">{date} · {note.data.kind}</div>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>
      {note.data.tags.length > 0 && <div class="tags">{note.data.tags.map((tag: string) => <span>{tag}</span>)}</div>}
    </header>

    {note.data.image && <figure class="cover"><img src={note.data.image} alt="" /></figure>}
    <div class="prose"><Content /></div>
  </article>
</JournalLayout>

<style>
  .note { max-width: 920px; margin: 0 auto; }
  .back { display: inline-block; margin-bottom: 34px; color: var(--muted); font: 10px/1 var(--mono); text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
  .back:hover { color: var(--signal); }
  header { padding-bottom: 34px; border-bottom: 1px solid var(--line); }
  h1 { margin: 15px 0 17px; font-size: clamp(46px,6.2vw,80px); line-height: .98; letter-spacing: -.055em; font-weight: 500; }
  .summary { max-width: 760px; margin: 0; color: #66665f; font: 14px/1.7 var(--mono); }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 24px; }
  .tags span { padding: 5px 7px; border: 1px solid var(--line); border-radius: 3px; color: var(--muted); font: 9px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em; }
  .cover { margin: 34px 0 0; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; background: #d7d6cf; }
  .cover img { width: 100%; max-height: 620px; object-fit: cover; image-rendering: pixelated; }
  .prose { margin-top: 46px; font-size: 18px; line-height: 1.76; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote) { max-width: 730px; }
  .prose :global(h2) { max-width: 760px; margin: 2.6em 0 .7em; font-size: 34px; line-height: 1.08; letter-spacing: -.035em; font-weight: 550; }
  .prose :global(h3) { margin-top: 2.1em; font-size: 23px; }
  .prose :global(code) { padding: .12em .3em; background: #eceae3; font-family: var(--mono); font-size: .86em; }
  .prose :global(pre) { overflow-x: auto; padding: 18px; border: 1px solid var(--line); border-radius: 5px; background: #f3f1ea; font: 13px/1.6 var(--mono); }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(blockquote) { margin-left: 0; padding-left: 20px; border-left: 2px solid var(--signal); color: #5f5f58; }
  .prose :global(a) { text-underline-offset: 3px; }
</style>
