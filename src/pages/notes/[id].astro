---
import { getCollection, render } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => !note.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---
<JournalLayout title={note.data.title} description={note.data.summary}>
  <article class="note">
    <a class="back" href="/home">← journal</a>
    <header>
      <div class="post-meta">{date} · {note.data.kind}</div>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>
    </header>
    {note.data.image && <figure class="cover"><img src={note.data.image} alt="" /></figure>}
    <div class="prose"><Content /></div>
  </article>
</JournalLayout>

<style>
  .note { max-width: 760px; margin: 0 auto; }
  .back { display: inline-block; margin-bottom: 28px; color: var(--muted); font-size: 11px; text-decoration: none; }
  header { padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  h1 { margin: 12px 0 12px; font-size: clamp(30px, 4.4vw, 48px); line-height: 1.04; letter-spacing: -.035em; font-weight: 520; }
  .summary { max-width: 650px; margin: 0; color: #6b6b65; font-size: 13px; line-height: 1.6; }
  .cover { margin: 28px 0 0; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #deddd6; }
  .cover img { width: 100%; max-height: 520px; object-fit: cover; image-rendering: pixelated; }
  .prose { margin-top: 38px; font-size: 16px; line-height: 1.72; }
  .prose :global(h2) { margin: 2.4em 0 .65em; font-size: 25px; line-height: 1.12; letter-spacing: -.02em; font-weight: 560; }
  .prose :global(h3) { margin-top: 2em; font-size: 19px; }
  .prose :global(code) { padding: .12em .3em; background: #eceae4; font-family: var(--mono); font-size: .86em; }
  .prose :global(pre) { overflow-x: auto; padding: 16px; border: 1px solid var(--line); border-radius: 5px; background: #f0efe9; font: 12px/1.6 var(--mono); }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(blockquote) { margin-left: 0; padding-left: 18px; border-left: 1px solid #a9a8a1; color: #5f5f59; }
  .prose :global(a) { text-underline-offset: 3px; }
</style>
