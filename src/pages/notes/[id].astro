---
import { getCollection, render } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => !note.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const author = 'Thomas V.';
const wordCount = note.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readTime = Math.max(1, Math.round(wordCount / 200));
---
<JournalLayout title={note.data.title} description={note.data.summary}>
  <article class="note">
    {note.data.image && (
      <div class="cover">
        <img src={note.data.image} alt="" />
      </div>
    )}

    <header class="article-header">
      <div class="kicker">{note.data.kind}{note.data.project && <> · {note.data.project}</>}</div>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>

      <dl class="meta-grid">
        <div><dt>Written by</dt><dd>{author}</dd></div>
        <div><dt>Published</dt><dd>{date}</dd></div>
        <div><dt>Read time</dt><dd>{readTime} min</dd></div>
        {note.data.project && <div><dt>Project</dt><dd>{note.data.project}</dd></div>}
      </dl>

      {note.data.tags.length > 0 && (
        <div class="tags" aria-label="Article tags">
          {note.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose"><Content /></div>
  </article>
</JournalLayout>

<style>
  .note { max-width: 700px; margin: 0 auto; padding: 20px 18px 90px; }

  .cover { margin: 0 0 26px; background: var(--line-soft); }
  .cover img { display: block; width: 100%; max-height: 360px; object-fit: cover; image-rendering: pixelated; filter: grayscale(1) contrast(1.05); }

  /* metadata reads as a highlighted band, not a boxed card */
  .article-header { background: var(--panel); padding: 26px 26px 28px; }
  .kicker { color: var(--muted); font: var(--fs-meta) var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 15px 0 15px; font-family: var(--serif); font-size: var(--fs-h1); line-height: 1.05; letter-spacing: -.02em; font-weight: 560; }
  .summary { margin: 0; max-width: 600px; color: var(--muted); font-family: var(--serif); font-size: var(--fs-body); line-height: 1.5; }
  .meta-grid { margin: 24px 0 0; padding-top: 20px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .meta-grid > div { display: grid; gap: 5px; }
  .meta-grid dt { margin: 0; color: var(--muted); font: var(--fs-meta) var(--mono); letter-spacing: .07em; text-transform: uppercase; }
  .meta-grid dd { margin: 0; color: var(--ink); font: 600 var(--fs-meta) var(--mono); line-height: 1.2; }
  .tags { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 7px; }
  .tags span { padding: 6px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: rgba(255,255,255,.6); font: var(--fs-meta) var(--mono); }

  .prose { margin-top: 26px; font-family: var(--serif); font-size: var(--fs-body); line-height: 1.7; }
  .prose :global(p) { margin: 0 0 1.3em; }
  .prose :global(h2) { margin: 1em 0 .5em; font-family: var(--serif); font-size: var(--fs-h2); line-height: 1.2; font-weight: 560; }
  .prose :global(h3) { margin: .9em 0 .4em; font-family: var(--serif); font-size: var(--fs-h2); line-height: 1.2; font-weight: 560; }
  .prose :global(strong) { font-weight: 620; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.15em; }
  .prose :global(li) { margin: 0 0 .5em; }
  .prose :global(code) { padding: .12em .32em; background: var(--line-soft); font-family: var(--mono); font-size: .78em; }

  /* code / schema / data blocks: a colour change, not a boxed widget */
  .prose :global(pre) { margin: 1.8em 0; padding: 4px 18px 16px; overflow-x: auto; border-radius: 4px; font-family: var(--mono); font-size: 13px; line-height: 1.65; }
  .prose :global(pre[data-language])::before { content: attr(data-language); display: block; padding-top: 12px; margin-bottom: 10px; color: var(--muted); font: var(--fs-meta) var(--mono); text-transform: uppercase; letter-spacing: .07em; }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(pre span[style*="token-keyword"]) { font-weight: 600; }
  .prose :global(pre span[style*="token-comment"]) { font-style: italic; }

  .prose :global(blockquote) { margin: 1.8em 0; padding: 3px 0 3px 20px; border-left: 2px solid var(--muted); color: var(--muted); font-family: var(--serif); font-size: var(--fs-body); line-height: 1.5; }
  .prose :global(a) { text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .note { padding: 12px 10px 64px; }
    .article-header { padding: 20px 18px 22px; }
    .meta-grid { gap: 18px; }
  }
</style>
