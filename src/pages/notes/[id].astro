---
import { getCollection, render } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => !note.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const author = note.data.author ?? 'ピザって呼んで';
---
<JournalLayout title={note.data.title} description={note.data.summary}>
  <article class="note">
    <a class="back" href="/home">← Journal</a>

    <header class="article-header">
      <div class="article-kicker">{note.data.kind}{note.data.project && <> · {note.data.project}</>}</div>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>

      <div class="byline">
        <div>
          <span class="meta-label">Written by</span>
          <strong>{author}</strong>
        </div>
        <div>
          <span class="meta-label">Published</span>
          <strong>{date}</strong>
        </div>
      </div>

      {note.data.tags.length > 0 && (
        <div class="tags" aria-label="Article tags">
          {note.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    {note.data.image && <figure class="cover"><img src={note.data.image} alt="" /></figure>}

    <div class="article-grid">
      <aside class="article-aside" aria-label="Article information">
        <span>{note.data.kind}</span>
        <span>{date}</span>
        {note.data.project && <span>{note.data.project}</span>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</JournalLayout>

<style>
  .note { max-width: 980px; margin: 0 auto; padding: 20px 18px 80px; }
  .back { display: inline-block; margin: 4px 0 54px; color: var(--muted); font: 9px/1 var(--mono); text-decoration: none; text-transform: uppercase; letter-spacing: .06em; }
  .article-header { max-width: 790px; padding-bottom: 34px; border-bottom: 1px solid var(--line); }
  .article-kicker { color: var(--muted); font: 9px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 18px 0 18px; font-size: clamp(38px, 5vw, 64px); line-height: .99; letter-spacing: -.045em; font-weight: 520; }
  .summary { max-width: 690px; margin: 0; color: #656760; font-size: 16px; line-height: 1.58; }
  .byline { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 36px; }
  .byline > div { display: grid; gap: 6px; }
  .meta-label { color: var(--muted); font: 8px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; }
  .byline strong { font-size: 12px; line-height: 1.2; font-weight: 560; }
  .tags { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 7px; }
  .tags span { padding: 6px 8px; border: 1px solid var(--line); border-radius: 999px; color: #62645e; background: rgba(255,255,255,.55); font: 8px/1 var(--mono); }
  .cover { margin: 36px 0 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #deddd6; }
  .cover img { width: 100%; max-height: 560px; object-fit: cover; image-rendering: pixelated; }
  .article-grid { margin-top: 52px; display: grid; grid-template-columns: 120px minmax(0, 650px); gap: 44px; align-items: start; }
  .article-aside { position: sticky; top: 28px; display: grid; gap: 9px; color: #8a8b85; font: 8px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
  .prose { min-width: 0; font-size: 17px; line-height: 1.78; letter-spacing: -.006em; }
  .prose :global(p) { margin: 0 0 1.35em; }
  .prose :global(h2) { margin: 2.6em 0 .72em; font-size: 28px; line-height: 1.12; letter-spacing: -.025em; font-weight: 560; }
  .prose :global(h3) { margin: 2.2em 0 .7em; font-size: 20px; line-height: 1.2; }
  .prose :global(strong) { font-weight: 620; }
  .prose :global(code) { padding: .12em .3em; background: #eceae4; font-family: var(--mono); font-size: .84em; }
  .prose :global(pre) { margin: 2em 0; overflow-x: auto; padding: 20px; border: 1px solid var(--line); border-radius: 7px; background: #f0efe9; font: 12px/1.65 var(--mono); }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(blockquote) { margin: 2em 0; padding: 4px 0 4px 22px; border-left: 2px solid #aaa9a2; color: #555750; font-size: 19px; line-height: 1.55; }
  .prose :global(a) { text-underline-offset: 3px; }

  @media (max-width: 820px) {
    .note { padding: 12px 8px 64px; }
    .back { margin-bottom: 36px; }
    .article-grid { grid-template-columns: 1fr; gap: 0; margin-top: 38px; }
    .article-aside { display: none; }
    h1 { font-size: clamp(36px, 10vw, 52px); }
  }
</style>
