---
import { getCollection } from 'astro:content';
import JournalLayout from '../layouts/JournalLayout.astro';

const notes = (await getCollection('notes'))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = notes.find((note) => note.data.featured) ?? notes[0];
const rest = notes.filter((note) => note.id !== featured?.id);
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const featuredImage = featured?.data.image ?? '/assets/dither-reflection.png';
---
<JournalLayout>
  <header class="intro">
    <div class="eyebrow">PERSONAL / RESEARCH JOURNAL</div>
    <h1>A quiet place to document what I’m working on.</h1>
    <p>Research, build logs, experiments, useful hacks and things I’m excited enough about to explain properly.</p>
  </header>

  {featured && (
    <section aria-labelledby="latest-heading">
      <div class="section-heading"><span id="latest-heading">Latest note</span></div>
      <a class="featured-card" href={`/notes/${featured.id}`}>
        <div class="featured-copy">
          <div class="post-meta">{formatDate(featured.data.date)} · {featured.data.kind}</div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.summary}</p>
          <span class="read">Read ↗</span>
        </div>
        <div class="featured-image"><img src={featuredImage} alt="" /></div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="posts-section" aria-labelledby="more-heading">
      <div class="section-heading"><span id="more-heading">Journal</span></div>
      <div class="post-grid">
        {rest.map((note) => (
          <a class:list={['post-card', { 'has-image': Boolean(note.data.image) }]} href={`/notes/${note.id}`}>
            {note.data.image && <div class="post-image"><img src={note.data.image} alt="" /></div>}
            <div class="post-body">
              <div class="post-meta">{formatDate(note.data.date)} · {note.data.kind}</div>
              <h2>{note.data.title}</h2>
              <p>{note.data.summary}</p>
              <span class="read">Read ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</JournalLayout>

<style>
  .intro { max-width: 680px; padding: 2px 0 42px; }
  .intro h1 { margin: 12px 0 12px; max-width: 640px; font-size: clamp(30px, 4vw, 46px); line-height: 1.04; letter-spacing: -.035em; font-weight: 520; }
  .intro p { max-width: 590px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .featured-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .9fr); min-height: 340px; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; text-decoration: none; background: rgba(255,255,252,.58); }
  .featured-copy { padding: clamp(24px, 3.4vw, 38px); display: flex; flex-direction: column; }
  .featured-copy h2 { margin: 26px 0 11px; font-size: clamp(27px, 3.5vw, 42px); line-height: 1.03; letter-spacing: -.035em; font-weight: 520; }
  .featured-copy p, .post-body p { margin: 0; color: #6f6f68; font-size: 12px; line-height: 1.55; }
  .featured-copy .read { margin-top: auto; padding-top: 26px; }

  .featured-image, .post-image { overflow: hidden; background: #deddd6; }
  .featured-image img, .post-image img { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; filter: grayscale(1) contrast(1.03); transition: filter .25s ease; }
  .featured-card:hover img, .post-card:hover img { filter: grayscale(.2) contrast(1.03); }

  .posts-section { margin-top: 38px; }
  .post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .post-card { min-height: 230px; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; text-decoration: none; background: rgba(255,255,252,.46); display: grid; }
  .post-card.has-image { grid-template-rows: 135px 1fr; }
  .post-image { border-bottom: 1px solid var(--line); }
  .post-body { padding: 20px; display: flex; flex-direction: column; }
  .post-body h2 { margin: 16px 0 9px; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.06; letter-spacing: -.025em; font-weight: 520; }
  .post-card .read { margin-top: auto; padding-top: 22px; }

  @media (max-width: 760px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-image { min-height: 230px; order: -1; }
  }
  @media (max-width: 560px) {
    .post-grid { grid-template-columns: 1fr; }
    .intro h1 { font-size: 32px; }
    .featured-copy h2 { font-size: 28px; }
  }
</style>
