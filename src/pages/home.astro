---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = notes.find((note) => note.data.featured) ?? notes[0];
const rest = notes.filter((note) => note.id !== featured?.id);
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const featuredImage = featured?.data.image ?? '/assets/dither-reflection.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#efeee8" />
    <meta name="description" content="Research notes, build logs, experiments and useful things Thomas is learning while making software and AI systems." />
    <link rel="alternate" type="application/rss+xml" title="Thomas Vezzani" href="/rss.xml" />
    <title>Thomas — research journal</title>
  </head>
  <body>
    <div class="room">
      <aside class="rail">
        <a class="identity" href="/" aria-label="Back to the visit card">
          <span class="jp">ピザって呼んで</span>
          <span class="name">thomas</span>
        </a>

        <nav aria-label="Primary">
          <a class="active" href="/home">Journal</a>
          <a href="/notes">Archive</a>
          <a href="/work">Work</a>
          <a href="/about">About</a>
        </nav>

        <div class="rail-note">
          <span>RESEARCH ROOM</span>
          <p>Work in public, explained clearly enough to follow without flattening the interesting parts.</p>
        </div>

        <div class="rail-bottom">
          <a href="https://github.com/appellemoipizza">GitHub ↗</a>
          <a href="/rss.xml">RSS ↗</a>
        </div>
      </aside>

      <main>
        <header class="intro">
          <div class="eyebrow">PERSONAL / RESEARCH JOURNAL</div>
          <h1>A quiet place to document what I’m working on.</h1>
          <p>Research, build logs, experiments, useful hacks and things I’m excited enough about to explain properly.</p>
        </header>

        {featured && (
          <section class="featured-section" aria-labelledby="latest-heading">
            <div class="section-heading">
              <span id="latest-heading">Latest note</span>
              <a href="/notes">Full archive ↗</a>
            </div>

            <a class="featured-card" href={`/notes/${featured.id}`}>
              <div class="featured-copy">
                <div class="post-meta">{formatDate(featured.data.date)} · {featured.data.kind}</div>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.summary}</p>
                <span class="read">Read note ↗</span>
              </div>
              <div class="featured-image">
                <img src={featuredImage} alt="" />
              </div>
            </a>
          </section>
        )}

        <section class="posts-section" aria-labelledby="recent-heading">
          <div class="section-heading">
            <span id="recent-heading">More from the notebook</span>
            <span class="count">{String(rest.length).padStart(2, '0')}</span>
          </div>

          <div class="post-grid">
            {rest.map((note) => (
              <a class:list={['post-card', { 'has-image': Boolean(note.data.image) }]} href={`/notes/${note.id}`}>
                {note.data.image && (
                  <div class="post-image">
                    <img src={note.data.image} alt="" />
                  </div>
                )}
                <div class="post-body">
                  <div class="post-meta">{formatDate(note.data.date)} · {note.data.kind}</div>
                  <h2>{note.data.title}</h2>
                  <p>{note.data.summary}</p>
                  <span class="read">Read ↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </main>
    </div>

    <style>
      :root {
        --ink: #1e1f1d;
        --muted: #77776f;
        --paper: #fbfaf6;
        --paper-2: #f2f0e9;
        --room: #151615;
        --line: #d7d4ca;
        --signal: #3155d9;
        --mono: "IBM Plex Mono", "SFMono-Regular", ui-monospace, Menlo, monospace;
        --sans: "Space Grotesk", "Helvetica Neue", Arial, system-ui, sans-serif;
      }

      * { box-sizing: border-box; }
      html { background: var(--room); }
      body {
        margin: 0;
        color: var(--ink);
        font-family: var(--sans);
        background: var(--room);
      }
      a { color: inherit; }
      img { display: block; max-width: 100%; }

      .room {
        width: min(1480px, calc(100% - 28px));
        min-height: calc(100vh - 28px);
        margin: 14px auto;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        overflow: hidden;
        border: 1px solid #2d2e2b;
        border-radius: 9px;
        background:
          radial-gradient(circle at 1px 1px, rgba(30,31,29,.045) 1px, transparent 0) 0 0 / 7px 7px,
          var(--paper);
        box-shadow: 0 24px 70px rgba(0,0,0,.22);
      }

      .rail {
        min-height: calc(100vh - 28px);
        padding: 30px 24px;
        border-right: 1px solid var(--line);
        background: rgba(247,245,239,.84);
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 14px;
        align-self: start;
      }

      .identity { text-decoration: none; display: grid; gap: 3px; }
      .identity .jp { font-size: 15px; font-weight: 650; letter-spacing: -.03em; }
      .identity .name, .eyebrow, .post-meta, .count, .read, .rail nav a, .rail-bottom a, .section-heading, .rail-note span {
        font-family: var(--mono);
      }
      .identity .name { font-size: 10px; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); }

      .rail nav { display: grid; gap: 4px; margin-top: 64px; }
      .rail nav a {
        font-size: 11px;
        text-decoration: none;
        padding: 7px 9px;
        border-radius: 4px;
        color: #5e5e58;
      }
      .rail nav a:hover, .rail nav a.active { color: var(--ink); background: #ebe9e2; }
      .rail nav a.active::before { content: "•"; margin-right: 8px; }

      .rail-note { margin-top: 54px; padding-top: 14px; border-top: 1px solid var(--line); }
      .rail-note span { font-size: 9px; letter-spacing: .12em; color: var(--muted); }
      .rail-note p { margin: 10px 0 0; font-size: 12px; line-height: 1.55; color: #696961; }

      .rail-bottom { margin-top: auto; display: grid; gap: 8px; }
      .rail-bottom a { font-size: 10px; color: var(--muted); text-decoration: none; }
      .rail-bottom a:hover { color: var(--ink); }

      main { padding: 58px clamp(28px, 5vw, 72px) 76px; min-width: 0; }
      .intro { max-width: 880px; padding: 8px 0 58px; }
      .eyebrow { font-size: 9px; line-height: 1.4; letter-spacing: .13em; color: var(--signal); text-transform: uppercase; }
      .intro h1 {
        margin: 15px 0 17px;
        max-width: 820px;
        font-size: clamp(46px, 6vw, 82px);
        line-height: .98;
        letter-spacing: -.055em;
        font-weight: 500;
      }
      .intro p { max-width: 660px; margin: 0; font: 14px/1.65 var(--mono); color: #77776f; }

      .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 10px;
        margin-bottom: 14px;
        border-bottom: 1px solid var(--line);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .11em;
        color: #5d5d57;
      }
      .section-heading a { text-decoration: none; }
      .section-heading a:hover { color: var(--signal); }
      .count { color: var(--muted); }

      .featured-card {
        display: grid;
        grid-template-columns: minmax(0, .95fr) minmax(320px, 1.05fr);
        min-height: 440px;
        border: 1px solid var(--line);
        border-radius: 7px;
        overflow: hidden;
        text-decoration: none;
        background: rgba(255,255,252,.78);
      }
      .featured-copy { padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; }
      .post-meta { font-size: 9px; line-height: 1.4; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); }
      .featured-copy h2 { margin: 36px 0 15px; font-size: clamp(34px, 4.6vw, 62px); line-height: .98; letter-spacing: -.05em; font-weight: 500; }
      .featured-copy p { max-width: 590px; margin: 0; font: 13px/1.65 var(--mono); color: #6e6e67; }
      .read { margin-top: auto; padding-top: 34px; font-size: 9px; text-transform: uppercase; letter-spacing: .09em; }

      .featured-image, .post-image { overflow: hidden; background: #d7d6cf; }
      .featured-image img, .post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: pixelated;
        filter: grayscale(1) contrast(1.04);
        transition: filter .28s ease, transform .55s ease;
      }
      .featured-card:hover img, .post-card:hover img { filter: grayscale(.15) contrast(1.04); transform: scale(1.01); }
      .featured-card:hover .read, .post-card:hover .read { color: var(--signal); }

      .posts-section { margin-top: 48px; }
      .post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .post-card {
        min-height: 285px;
        border: 1px solid var(--line);
        border-radius: 7px;
        overflow: hidden;
        text-decoration: none;
        background: rgba(255,255,252,.72);
        display: grid;
      }
      .post-card.has-image { grid-template-rows: 165px 1fr; }
      .post-image { border-bottom: 1px solid var(--line); }
      .post-body { padding: 24px; display: flex; flex-direction: column; }
      .post-body h2 { margin: 20px 0 11px; font-size: clamp(25px, 2.8vw, 37px); line-height: 1.02; letter-spacing: -.043em; font-weight: 500; }
      .post-body p { margin: 0; font: 12px/1.62 var(--mono); color: #6e6e67; }
      .post-card .read { margin-top: auto; padding-top: 28px; }
      .post-card:hover { border-color: #aaa79f; }

      @media (max-width: 860px) {
        .room { width: 100%; min-height: 100vh; margin: 0; border: 0; border-radius: 0; grid-template-columns: 1fr; }
        .rail { min-height: auto; position: static; padding: 18px 20px; border-right: 0; border-bottom: 1px solid var(--line); flex-direction: row; align-items: center; gap: 20px; }
        .rail nav { display: flex; flex-wrap: wrap; margin: 0 0 0 auto; gap: 3px; }
        .rail-note, .rail-bottom { display: none; }
        main { padding: 38px 20px 60px; }
        .featured-card { grid-template-columns: 1fr; }
        .featured-image { min-height: 310px; order: -1; }
      }

      @media (max-width: 620px) {
        .rail { align-items: flex-start; flex-direction: column; }
        .rail nav { margin-left: 0; }
        .intro h1 { font-size: clamp(42px, 13vw, 64px); }
        .post-grid { grid-template-columns: 1fr; }
        .featured-copy h2 { font-size: 40px; }
      }
    </style>
  </body>
</html>
