---
import { getCollection } from 'astro:content';
import JournalLayout from '../layouts/JournalLayout.astro';

const notes = (await getCollection('notes'))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = notes[0];
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const heroImage = featured?.data.image ?? '/assets/dither-reflection.png';
---
<JournalLayout>
  <section class="hero-panel">
    <div class="hero-copy">
      <div class="eyebrow">operating companion / research journal</div>
      <h1>Millie helps<br />Always Late<br />think, build<br />and ship.</h1>
      <p>A quiet record of the research, systems, experiments and useful things behind the work.</p>
      {featured && <a class="hero-action" href={`/notes/${featured.id}`}>Read latest note ↗</a>}
    </div>

    <a class="hero-visual" href={featured ? `/notes/${featured.id}` : '/home'} aria-label="Open latest journal note">
      <img src={heroImage} alt="" />
      {featured && (
        <div class="visual-caption">
          <span>latest</span>
          <strong>{featured.data.title}</strong>
        </div>
      )}
    </a>
  </section>

  {notes.length > 0 && (
    <section class="notes-section" aria-labelledby="notes-heading">
      <div class="section-heading" id="notes-heading">Latest notes</div>
      <div class="notes-grid">
        {notes.map((note) => (
          <article class="note-card">
            {note.data.image && (
              <a class="note-image" href={`/notes/${note.id}`}>
                <img src={note.data.image} alt="" />
              </a>
            )}
            <div class="note-copy">
              <div class="post-meta">{formatDate(note.data.date)} · {note.data.kind}</div>
              <a class="note-title" href={`/notes/${note.id}`}><h2>{note.data.title}</h2></a>
              <p>{note.data.summary}</p>
              <a class="read" href={`/notes/${note.id}`}>Read ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</JournalLayout>

<style>
  .hero-panel {
    min-height: 430px;
    display: grid;
    grid-template-columns: minmax(320px, .72fr) minmax(0, 1.28fr);
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow:
      0 1px 0 rgba(255,255,255,.95) inset,
      0 -1px 0 rgba(35,36,35,.025) inset,
      0 10px 26px rgba(35,36,35,.045);
  }

  .hero-copy {
    padding: clamp(30px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--line-soft);
  }

  .hero-copy h1 {
    margin: 14px 0 12px;
    font-size: clamp(32px, 4.2vw, 52px);
    line-height: .99;
    letter-spacing: -.045em;
    font-weight: 560;
  }

  .hero-copy p {
    max-width: 330px;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.55;
  }

  .hero-action {
    align-self: flex-start;
    margin-top: 24px;
    padding: 9px 12px;
    border-radius: 6px;
    background: #242522;
    color: white;
    font: 8px/1 var(--mono);
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(255,255,255,.18) inset;
  }

  .hero-visual {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    text-decoration: none;
    background: #e5e6e2;
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    min-height: 430px;
    object-fit: cover;
    image-rendering: pixelated;
    filter: grayscale(1) contrast(1.04);
    transition: filter .25s ease, transform .5s ease;
  }

  .hero-visual:hover img {
    filter: grayscale(.18) contrast(1.02);
    transform: scale(1.008);
  }

  .visual-caption {
    position: absolute;
    right: 12px;
    bottom: 12px;
    max-width: min(300px, calc(100% - 24px));
    padding: 11px 13px;
    display: grid;
    gap: 4px;
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(35,36,35,.12);
    border-radius: 7px;
    box-shadow: 0 1px 0 rgba(255,255,255,.85) inset;
    backdrop-filter: blur(8px);
  }

  .visual-caption span {
    color: var(--muted);
    font: 7px/1 var(--mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .visual-caption strong {
    font-size: 11px;
    line-height: 1.25;
    font-weight: 560;
  }

  .notes-section { margin-top: 18px; }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .note-card {
    min-height: 260px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 9px;
    box-shadow:
      0 1px 0 rgba(255,255,255,.95) inset,
      0 -1px 0 rgba(35,36,35,.025) inset,
      0 7px 18px rgba(35,36,35,.035);
  }

  .note-card:not(:has(.note-image)) { grid-template-rows: 1fr; }

  .note-image {
    display: block;
    overflow: hidden;
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
    background: #e6e7e3;
  }

  .note-image img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    image-rendering: pixelated;
    filter: grayscale(1) contrast(1.03);
    transition: filter .22s ease;
  }

  .note-image:hover img { filter: grayscale(.18) contrast(1.02); }

  .note-copy {
    min-height: 150px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .note-title { text-decoration: none; }

  .note-copy h2 {
    margin: 10px 0 7px;
    font-size: 16px;
    line-height: 1.12;
    letter-spacing: -.02em;
    font-weight: 580;
  }

  .note-copy p {
    margin: 0;
    color: #74766f;
    font-size: 10.5px;
    line-height: 1.5;
  }

  .note-copy .read {
    margin-top: auto;
    padding-top: 18px;
  }

  @media (max-width: 980px) {
    .hero-panel { grid-template-columns: minmax(280px, .9fr) minmax(0, 1.1fr); }
    .notes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .hero-panel { grid-template-columns: 1fr; min-height: 0; }
    .hero-copy { border-right: 0; border-bottom: 1px solid var(--line-soft); padding: 28px 22px; }
    .hero-copy h1 { font-size: 36px; }
    .hero-visual, .hero-visual img { min-height: 260px; }
    .notes-grid { grid-template-columns: 1fr; }
  }
</style>
