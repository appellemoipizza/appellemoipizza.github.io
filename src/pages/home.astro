---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';

const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort((a,b) => a.data.order - b.data.order);
const notes = (await getCollection('notes')).filter((n) => !n.data.draft).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
---
<BaseLayout title="Thomas — inside the lab" description="Software, AI systems, visual worlds, notes and experiments by Thomas.">
  <div class="shell portfolio-home">
    <section class="world-hero">
      <div class="world-hero__copy">
        <div class="kicker">you entered the portfolio / drag things</div>
        <h1>The software is real.<br />It also has another self.</h1>
        <p>I make products, agents and small systems. This is where the practical work and the visual world around it are allowed to meet.</p>
        <div class="world-hero__legend">
          <span>move → depth</span>
          <span>drag → flip</span>
          <span>hover → swap</span>
        </div>
      </div>
      <div class="world-hero__image hero-image">
        <img src="/assets/dither-reflection.png" alt="Tokyo through a window with Thomas reflected in the glass" />
        <div class="image-stamp">TOKYO / WINDOW / NIGHT SYSTEM</div>
      </div>
    </section>

    <section class="section program-deck">
      <div class="section-head">
        <div>
          <div class="micro-label">PROGRAMS / OTHER SELVES</div>
          <h2>Selected work</h2>
        </div>
        <div class="section-side-note">Each card has a second side. The character is not decoration; it is another way of describing what the program is.</div>
      </div>
      <div class="project-grid world-project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="deck-caption">The illustrated robot/anime identities will replace the typographic backs as each visual world is authored.</div>
    </section>

    <section class="section visual-worlds">
      <div class="section-head">
        <div>
          <div class="micro-label">CHARACTER SHEETS / ENVIRONMENTS / STATES</div>
          <h2>Visual worlds</h2>
        </div>
        <a class="section-link" href="/notes">all notes ↗</a>
      </div>

      <a class="world-card" href="/notes/2026-08-21-millie-visual-world">
        <div class="world-card__art world-image">
          <div class="world-orbit world-orbit--one"></div>
          <div class="world-orbit world-orbit--two"></div>
          <img src="/assets/dither-reflection-invert.png" alt="Dithered Tokyo atmosphere used as a temporary visual-world field" />
          <div class="world-card__number">001</div>
        </div>
        <div class="world-card__copy">
          <div class="micro-label">MILLIE / VISUAL WORLD 001</div>
          <h3>Software can have a character without becoming a mascot brand.</h3>
          <p>The first world: silhouette, emotional states, environments and the rule that the creature should explain the intelligence behind the tools.</p>
          <span>open character sheet ↗</span>
        </div>
      </a>

      <div class="world-queue">
        <div><span>002</span><strong>Wakomi</strong><em>resident guide / paper weather / Japan</em></div>
        <div><span>003</span><strong>huhu</strong><em>quiet shadow / silence / local memory</em></div>
        <div><span>004</span><strong>motes</strong><em>field creature / clusters / pixel habitats</em></div>
        <div><span>005</span><strong>Lexine</strong><em>archive familiar / citations / restraint</em></div>
        <div><span>006</span><strong>Loket</strong><em>document courier / order / small office rituals</em></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <div class="micro-label">FIELD NOTES</div>
          <h2>Notes & films</h2>
        </div>
        <a class="section-link" href="/notes">archive ↗</a>
      </div>
      <div class="note-list tactile-note-list">
        {notes.map((note) => <NoteRow note={note} />)}
      </div>
    </section>

    <section class="section lab-door">
      <div>
        <div class="micro-label">UNFINISHED / SMALL / WEIRD</div>
        <h2>The lab is allowed to be less resolved.</h2>
        <p>quack, product films, knowledge tools, local models, interface experiments, generated scenes and things that may never become companies.</p>
      </div>
      <a href="/lab">enter the lab ↗</a>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-home { padding-top: 28px; }
  .micro-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: #777872; margin-bottom: 8px; }

  .world-hero {
    min-height: 570px;
    display: grid;
    grid-template-columns: .78fr 1.22fr;
    border: 1px solid #232423;
    background: #f8f9f6;
    position: relative;
    overflow: hidden;
  }
  .world-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(35,36,35,.08) 1px, transparent 1px);
    background-size: 7px 7px;
    opacity: .38;
  }
  .world-hero__copy { padding: clamp(34px,5vw,72px); display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 1; }
  .world-hero h1 { margin: 16px 0 20px; font-size: clamp(48px,6.5vw,92px); max-width: 8.5ch; line-height: .89; letter-spacing: -.055em; }
  .world-hero p { max-width: 42ch; font-family: 'IBM Plex Mono', monospace; font-size: 12px; line-height: 1.75; color: #555650; }
  .world-hero__legend { margin-top: auto; padding-top: 44px; display: flex; gap: 18px; flex-wrap: wrap; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: #777872; }
  .world-hero__image { position: relative; min-height: 480px; border-left: 1px solid #232423; overflow: hidden; }
  .world-hero__image img { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .image-stamp { position: absolute; right: 14px; bottom: 12px; padding: 7px 9px; background: rgba(248,249,246,.82); backdrop-filter: blur(8px); border: 1px solid rgba(35,36,35,.55); font: 9px/1 'IBM Plex Mono', monospace; letter-spacing: .08em; }

  .program-deck { padding-top: 86px; }
  .section-head { align-items: flex-end; }
  .section-side-note { max-width: 39ch; font: 10px/1.6 'IBM Plex Mono', monospace; color: #777872; text-align: right; }
  .world-project-grid { perspective: 1600px; gap: 22px; }
  .deck-caption { margin-top: 20px; text-align: right; font: 9px/1.5 'IBM Plex Mono', monospace; color: #8a8b85; text-transform: uppercase; letter-spacing: .06em; }

  .visual-worlds { padding-top: 92px; }
  .world-card {
    min-height: 470px;
    display: grid;
    grid-template-columns: 1.22fr .78fr;
    color: inherit;
    text-decoration: none;
    border: 1px solid #232423;
    background: #f8f9f6;
  }
  .world-card__art { position: relative; overflow: hidden; border-right: 1px solid #232423; background: #121312; }
  .world-card__art img { display: block; width: 100%; height: 100%; min-height: 470px; object-fit: cover; opacity: .7; mix-blend-mode: screen; image-rendering: pixelated; }
  .world-card__number { position: absolute; left: 24px; bottom: 18px; font: 76px/.8 'Space Grotesk', sans-serif; letter-spacing: -.08em; color: rgba(255,255,255,.9); }
  .world-orbit { position: absolute; z-index: 2; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; mix-blend-mode: difference; }
  .world-orbit--one { width: 230px; height: 230px; left: 18%; top: 16%; }
  .world-orbit--two { width: 340px; height: 120px; right: -6%; bottom: 12%; transform: rotate(-16deg); }
  .world-card__copy { padding: clamp(28px,4vw,52px); display: flex; flex-direction: column; justify-content: center; }
  .world-card__copy h3 { margin: 8px 0 20px; font-size: clamp(34px,4.5vw,60px); line-height: .98; letter-spacing: -.045em; }
  .world-card__copy p { max-width: 38ch; font: 11px/1.7 'IBM Plex Mono', monospace; color: #60615c; }
  .world-card__copy span { margin-top: auto; padding-top: 36px; font: 10px/1 'IBM Plex Mono', monospace; }

  .world-queue { margin-top: 20px; border-top: 1px solid #d8d9d5; }
  .world-queue div { display: grid; grid-template-columns: 56px 150px 1fr; align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px solid #d8d9d5; font-family: 'IBM Plex Mono', monospace; }
  .world-queue span { font-size: 9px; color: #8b8c86; }
  .world-queue strong { font: 500 14px/1 'Space Grotesk', sans-serif; }
  .world-queue em { font-size: 10px; color: #777872; font-style: normal; }

  .tactile-note-list { display: grid; gap: 12px; }
  .lab-door { margin-bottom: 70px; padding: 38px; border: 1px solid #232423; display: flex; justify-content: space-between; gap: 28px; align-items: flex-end; background-image: radial-gradient(circle, rgba(35,36,35,.09) 1px, transparent 1px); background-size: 7px 7px; }
  .lab-door h2 { margin: 6px 0 12px; max-width: 14ch; font-size: clamp(32px,4vw,54px); line-height: .96; }
  .lab-door p { margin: 0; max-width: 58ch; font: 11px/1.7 'IBM Plex Mono', monospace; color: #60615c; }
  .lab-door a { flex: none; font: 10px/1 'IBM Plex Mono', monospace; color: inherit; }

  @media (max-width: 820px) {
    .world-hero, .world-card { grid-template-columns: 1fr; }
    .world-hero__image { border-left: 0; border-top: 1px solid #232423; min-height: 340px; }
    .world-card__art { border-right: 0; border-bottom: 1px solid #232423; }
    .section-side-note { display: none; }
    .world-queue div { grid-template-columns: 42px 100px 1fr; }
    .lab-door { align-items: flex-start; flex-direction: column; }
  }
</style>
