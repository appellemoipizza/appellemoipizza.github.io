---
const {
  title = 'Research journal',
  description = 'Research notes, build logs, experiments and useful things I am learning.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#E9EAE8" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Research journal" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="journal-shell">
      <aside class="journal-rail">
        <a class="identity" href="/">ピザって呼んで</a>
        <div class="rail-copy">
          <span class="rail-title">journal</span>
          <span class="rail-note">research / builds / notes</span>
        </div>
      </aside>
      <main><slot /></main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #272724;
    --muted: #85847d;
    --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace;
  }

  * { box-sizing: border-box; }

  @keyframes drift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 140px 140px, 0 0; }
  }

  html, body { margin: 0; min-height: 100%; }
  body {
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    background-color: #E9EAE8;
    background-image:
      radial-gradient(circle, rgba(35, 36, 35, 0.11) 1px, transparent 1px),
      linear-gradient(180deg, #F7F8F6 0%, #E2E3E0 100%);
    background-size: 7px 7px, 100% 100%;
    animation: drift 18s linear infinite;
  }

  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: #d8d9d5; color: var(--ink); }

  .journal-shell {
    width: min(1120px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(42px, 7vw, 92px);
    padding: 48px 0 84px;
  }

  .journal-rail {
    position: sticky;
    top: 48px;
    align-self: start;
    min-height: calc(100vh - 132px);
    display: flex;
    flex-direction: column;
  }

  .identity {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -.02em;
    text-decoration: none;
  }

  .rail-copy {
    margin-top: 62px;
    display: grid;
    gap: 8px;
  }

  .rail-title {
    font: 10px/1 var(--mono);
    color: var(--ink);
    text-transform: lowercase;
  }

  .rail-note {
    max-width: 125px;
    font: 9px/1.55 var(--mono);
    color: var(--muted);
  }

  main {
    min-width: 0;
    width: 100%;
    max-width: 820px;
  }

  .eyebrow, .post-meta, .section-heading, .read { font-family: var(--mono); }
  .eyebrow { color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .section-heading { margin-bottom: 22px; color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .post-meta { color: var(--muted); font-size: 9px; line-height: 1.4; letter-spacing: .05em; text-transform: uppercase; }
  .read { color: var(--muted); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; }

  @media (prefers-reduced-motion: reduce) {
    body { animation: none; }
  }

  @media (max-width: 720px) {
    .journal-shell {
      width: min(100% - 32px, 820px);
      grid-template-columns: 1fr;
      gap: 46px;
      padding: 24px 0 60px;
    }

    .journal-rail {
      position: static;
      min-height: auto;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
    }

    .rail-copy {
      margin-top: 0;
      display: block;
    }

    .rail-note { display: none; }
  }
</style>
