---
const {
  title = 'Research journal',
  description = 'Research notes, build logs, experiments and useful things I am learning.'
} = Astro.props;
const isArticle = Astro.url.pathname.startsWith('/notes/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#E9EAE8" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Research journal" href="/rss.xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem('journalSidebarCollapsed') !== '0') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="controls" aria-label="Journal controls">
      <button class="icon-btn" id="sidebar-toggle" type="button" aria-label="Toggle sidebar" title="Toggle sidebar">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="2.5" width="13" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/><line x1="6" y1="2.5" x2="6" y2="13.5" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
      {isArticle && (
        <a class="icon-btn" href="/home" aria-label="Back to journal" title="Back to journal">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      )}
    </div>
    <div class="site-frame">
      <aside class="journal-rail">
        <div class="rail-top">
          <a class="identity" href="/">ピザって呼んで</a>
          <span class="rail-kicker">journal</span>
        </div>
        <nav class="rail-nav" aria-label="Journal navigation">
          <a class="active" href="/home">Home</a>
          <span>Research</span>
          <span>Builds</span>
          <span>Notes</span>
        </nav>
        <div class="rail-bottom">
          <a href="https://github.com/appellemoipizza" class="icon-btn" aria-label="GitHub" title="GitHub">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        var toggle = document.getElementById('sidebar-toggle');
        if (!toggle) return;
        toggle.addEventListener('click', function () {
          var collapsed = !document.documentElement.classList.contains('sidebar-collapsed');
          document.documentElement.classList.toggle('sidebar-collapsed', collapsed);
          try { localStorage.setItem('journalSidebarCollapsed', collapsed ? '1' : '0'); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #242522;
    --muted: #7d7f79;
    --paper: #fbfcfa;
    --panel: #ffffff;
    --line: #dedfd9;
    --line-soft: #ecece8;
    --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace;

    /* monochrome syntax theme: shade/weight instead of hue */
    --astro-code-background: #eceae4;
    --astro-code-foreground: #3a3b39;
    --astro-code-token-keyword: #1c1d1b;
    --astro-code-token-function: #1c1d1b;
    --astro-code-token-string: #52544e;
    --astro-code-token-string-expression: #52544e;
    --astro-code-token-constant: #45463f;
    --astro-code-token-parameter: #45463f;
    --astro-code-token-punctuation: #9a9c94;
    --astro-code-token-comment: #8a8c85;
    --astro-code-token-link: #1c1d1b;
  }
  * { box-sizing: border-box; }
  @keyframes drift { from { background-position: 0 0, 0 0; } to { background-position: 140px 140px, 0 0; } }
  html, body { margin: 0; height: 100%; }
  body {
    height: 100vh;
    overflow: hidden;
    padding: 10px;
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    background-color: #E9EAE8;
    background-image: radial-gradient(circle, rgba(35,36,35,.11) 1px, transparent 1px), linear-gradient(180deg,#F7F8F6 0%,#E2E3E0 100%);
    background-size: 7px 7px, 100% 100%;
    animation: drift 18s linear infinite;
  }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: #d8d9d5; color: var(--ink); }

  /* controls live outside the card, in the desk gutter, and never move */
  .controls { position: fixed; top: 14px; left: 14px; z-index: 5; display: flex; flex-direction: column; gap: 6px; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; padding: 0; border: 1px solid var(--line); border-radius: 7px; background: var(--panel); color: var(--ink); cursor: pointer; flex: none; text-decoration: none; }
  .icon-btn:hover { background: var(--line-soft); }
  .rail-bottom .icon-btn { border-color: transparent; background: none; }
  .rail-bottom .icon-btn:hover { background: var(--line-soft); }

  /* the journal is a fixed-size card: it never grows, the content inside main scrolls */
  .site-frame {
    width: min(1320px, 100%);
    height: calc(100vh - 20px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    transition: grid-template-columns .18s ease;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid rgba(35,36,35,.14);
    border-radius: 11px;
    box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 18px 48px rgba(35,36,35,.08);
  }
  html.sidebar-collapsed .site-frame { grid-template-columns: 0px minmax(0, 1fr); }
  html.sidebar-collapsed .journal-rail { padding: 22px 0 17px; border-right-color: transparent; overflow: hidden; }
  html.sidebar-collapsed .journal-rail > * { opacity: 0; pointer-events: none; }

  .journal-rail {
    height: 100%;
    padding: 22px 17px 17px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    background: rgba(251,252,250,.98);
    overflow-y: auto;
  }
  .rail-top { margin-top: 40px; display: grid; gap: 9px; }
  .identity { font-size: 10px; font-weight: 650; line-height: 1.25; letter-spacing: -.02em; text-decoration: none; white-space: nowrap; }
  .rail-kicker { font: 7px/1 var(--mono); color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }
  .rail-nav { margin-top: 44px; display: grid; gap: 15px; font-size: 9px; line-height: 1; }
  .rail-nav a, .rail-nav span { text-decoration: none; color: #666861; }
  .rail-nav .active { color: var(--ink); }
  .rail-nav .active::before { content: "•"; margin-right: 8px; }
  .rail-bottom { margin-top: auto; }

  main { position: relative; min-width: 0; width: 100%; height: 100%; padding: 20px; background: #f8f8f5; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .eyebrow, .post-meta, .section-heading, .read { font-family: var(--mono); }
  .eyebrow { color: var(--muted); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .section-heading { margin-bottom: 10px; color: #5f615c; font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .post-meta { color: var(--muted); font-size: 8px; line-height: 1.4; letter-spacing: .05em; text-transform: uppercase; }
  .read { color: #5f615c; font-size: 8px; letter-spacing: .04em; text-transform: uppercase; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { body { animation: none; } }
  @media (max-width: 720px) {
    html, body { height: auto; }
    body { padding: 0; overflow: visible; }
    .controls { display: none; }
    .site-frame, html.sidebar-collapsed .site-frame { height: auto; min-height: 100vh; border-radius: 0; border-left: 0; border-right: 0; grid-template-columns: 1fr; }
    .journal-rail, html.sidebar-collapsed .journal-rail { height: auto; overflow-y: visible; padding: 14px 16px; border-right: 0; border-bottom: 1px solid var(--line); flex-direction: row; align-items: center; justify-content: space-between; }
    html.sidebar-collapsed .journal-rail > * { opacity: 1; pointer-events: auto; }
    .rail-top { margin-top: 0; display: flex; align-items: baseline; gap: 10px; }
    .rail-nav { margin: 0; display: block; }
    .rail-nav span, .rail-nav .active::before { display: none; }
    .rail-bottom { display: none; }
    main { height: auto; overflow-y: visible; padding: 12px; }
  }
</style>
