---
const {
  title = 'Research journal',
  description = 'Research notes, build logs, experiments and useful things I am learning.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f6f1" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Research journal" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a class="identity" href="/">ピザって呼んで</a>
        <span class="journal">journal</span>
      </header>
      <main><slot /></main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #272724;
    --muted: #85847d;
    --paper: #f7f6f1;
    --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: var(--paper); }
  body { color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: #deded8; color: var(--ink); }

  .page {
    width: min(920px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0 72px;
  }

  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 72px;
  }

  .identity {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -.02em;
    text-decoration: none;
  }

  .journal {
    color: var(--muted);
    font: 10px/1 var(--mono);
    text-transform: lowercase;
  }

  main { min-width: 0; }
  .eyebrow, .post-meta, .section-heading, .read { font-family: var(--mono); }
  .eyebrow { color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .section-heading { margin-bottom: 22px; color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .post-meta { color: var(--muted); font-size: 9px; line-height: 1.4; letter-spacing: .05em; text-transform: uppercase; }
  .read { color: var(--muted); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; }

  @media (max-width: 620px) {
    .page { width: min(100% - 32px, 920px); padding-top: 22px; }
    .topbar { margin-bottom: 52px; }
  }
</style>
