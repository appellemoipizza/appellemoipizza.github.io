---
const {
  title = 'Thomas — research journal',
  description = 'Research notes, build logs, experiments and useful things Thomas is learning while making software and AI systems.',
  active = 'journal'
} = Astro.props;
const links = [
  ['journal', 'Journal', '/home'],
  ['archive', 'Archive', '/notes'],
  ['work', 'Work', '/work'],
  ['about', 'About', '/about']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#efeee8" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Thomas Vezzani" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="room">
      <aside class="rail">
        <a class="identity" href="/" aria-label="Back to the visit card">
          <span class="jp">ピザって呼んで</span>
          <span class="name">thomas</span>
        </a>

        <nav aria-label="Primary">
          {links.map(([key, label, href]) => (
            <a class={active === key ? 'active' : undefined} href={href}>{label}</a>
          ))}
        </nav>

        <div class="rail-note">
          <span>RESEARCH ROOM</span>
          <p>Work in public, explained clearly enough to follow without flattening the interesting parts.</p>
        </div>

        <div class="rail-bottom">
          <a href="https://github.com/appellemoipizza">GitHub ↗</a>
          <a href="/rss.xml">RSS ↗</a>
        </div>
      </aside>

      <main><slot /></main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1e1f1d;
    --muted: #77776f;
    --paper: #fbfaf6;
    --paper-2: #f2f0e9;
    --room: #151615;
    --line: #d7d4ca;
    --signal: #3155d9;
    --mono: "IBM Plex Mono", "SFMono-Regular", ui-monospace, Menlo, monospace;
    --sans: "Space Grotesk", "Helvetica Neue", Arial, system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { background: var(--room); }
  body {
    margin: 0;
    color: var(--ink);
    font-family: var(--sans);
    background: var(--room);
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .18;
    background-image: radial-gradient(circle, rgba(255,255,255,.45) .55px, transparent .7px);
    background-size: 5px 5px;
  }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: var(--signal); color: white; }

  .room {
    width: min(1480px, calc(100% - 28px));
    min-height: calc(100vh - 28px);
    margin: 14px auto;
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    overflow: clip;
    border-radius: 9px;
    background: var(--paper);
    box-shadow: 0 18px 70px rgba(0,0,0,.18);
  }

  .rail {
    min-height: calc(100vh - 28px);
    padding: 28px 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 14px;
    align-self: start;
    background: rgba(242,240,233,.54);
  }
  .identity { display: grid; gap: 3px; text-decoration: none; }
  .identity .jp { font-size: 15px; font-weight: 650; letter-spacing: -.03em; }
  .identity .name { font: 10px/1.2 var(--mono); text-transform: uppercase; letter-spacing: .14em; color: var(--muted); }
  .rail nav { display: grid; gap: 4px; margin-top: 68px; }
  .rail nav a { padding: 8px 9px; border-radius: 4px; color: #575750; font: 11px/1 var(--mono); text-decoration: none; }
  .rail nav a:hover, .rail nav a.active { color: var(--ink); background: #eae8e1; }
  .rail nav a.active::before { content: "•"; margin-right: 8px; color: var(--signal); }
  .rail-note { margin-top: 58px; padding-top: 15px; border-top: 1px solid var(--line); }
  .rail-note span { font: 9px/1.2 var(--mono); letter-spacing: .11em; color: var(--signal); }
  .rail-note p { margin: 8px 0 0; color: var(--muted); font: 10px/1.55 var(--mono); }
  .rail-bottom { margin-top: auto; display: grid; gap: 8px; }
  .rail-bottom a { color: var(--muted); font: 10px/1 var(--mono); text-decoration: none; }
  .rail-bottom a:hover { color: var(--ink); }

  main { min-width: 0; padding: 56px clamp(28px, 5vw, 72px) 72px; }
  .eyebrow, .post-meta, .section-heading, .read, .count { font-family: var(--mono); }
  .eyebrow { color: var(--signal); font-size: 10px; line-height: 1.4; letter-spacing: .13em; text-transform: uppercase; }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    padding-bottom: 11px;
    border-bottom: 1px solid var(--line);
    color: #55544f;
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .section-heading a { text-decoration: none; }
  .section-heading a:hover { color: var(--signal); }
  .post-meta { color: var(--muted); font-size: 10px; line-height: 1.45; letter-spacing: .08em; text-transform: uppercase; }
  .read { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }

  @media (max-width: 860px) {
    .room { width: 100%; min-height: 100vh; margin: 0; border-radius: 0; grid-template-columns: 1fr; }
    .rail { min-height: auto; position: static; padding: 18px 20px; border-right: 0; border-bottom: 1px solid var(--line); flex-direction: row; align-items: center; gap: 20px; }
    .rail nav { display: flex; flex-wrap: wrap; margin: 0 0 0 auto; gap: 3px; }
    .rail-note, .rail-bottom { display: none; }
    main { padding: 38px 20px 60px; }
  }

  @media (max-width: 620px) {
    .rail { align-items: flex-start; flex-direction: column; }
    .rail nav { margin-left: 0; }
  }
</style>
