---
const {
  title = 'Research journal',
  description = 'Research notes, build logs, experiments and useful things I am learning.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#E4E5E2" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Research journal" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="journal-shell">
      <aside class="journal-rail">
        <a class="identity" href="/">ピザって呼んで</a>
        <div class="rail-copy">
          <span class="rail-title">journal</span>
          <span class="rail-note">research<br />builds<br />notes</span>
        </div>
      </aside>
      <main><slot /></main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #272724;
    --muted: #7d7d76;
    --paper: #fff;
    --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace;
  }

  * { box-sizing: border-box; }

  @keyframes drift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 140px 140px, 0 0; }
  }

  html, body { margin: 0; min-height: 100%; }
  body {
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    background-color: #E4E5E2;
    background-image:
      radial-gradient(circle, rgba(35, 36, 35, .12) 1px, transparent 1px),
      linear-gradient(180deg, #F0F1EE 0%, #DADCD8 100%);
    background-size: 7px 7px, 100% 100%;
    animation: drift 18s linear infinite;
  }

  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: #d8d9d5; color: var(--ink); }

  .journal-shell {
    width: min(1260px, calc(100% - 20px));
    min-height: 100vh;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 20px;
    padding: 22px 0 64px;
  }

  .journal-rail {
    position: sticky;
    top: 22px;
    align-self: start;
    min-height: calc(100vh - 86px);
    display: flex;
    flex-direction: column;
    padding-left: 2px;
  }

  .identity {
    font-size: 10px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .rail-copy {
    margin-top: 38px;
    display: grid;
    gap: 7px;
  }

  .rail-title {
    font: 8px/1 var(--mono);
    color: var(--ink);
    text-transform: lowercase;
  }

  .rail-note {
    font: 7px/1.65 var(--mono);
    color: var(--muted);
  }

  main {
    min-width: 0;
    width: 100%;
    max-width: 1080px;
  }

  .eyebrow, .post-meta, .section-heading, .read { font-family: var(--mono); }
  .eyebrow { color: var(--muted); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .section-heading { margin-bottom: 12px; color: var(--muted); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .post-meta { color: var(--muted); font-size: 8px; line-height: 1.4; letter-spacing: .05em; text-transform: uppercase; }
  .read { color: var(--muted); font-size: 8px; letter-spacing: .04em; text-transform: uppercase; }

  @media (prefers-reduced-motion: reduce) {
    body { animation: none; }
  }

  @media (max-width: 720px) {
    .journal-shell {
      width: min(100% - 20px, 1080px);
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 16px 0 48px;
    }

    .journal-rail {
      position: static;
      min-height: auto;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      padding-left: 0;
    }

    .rail-copy { margin-top: 0; display: block; }
    .rail-note { display: none; }
  }
</style>
